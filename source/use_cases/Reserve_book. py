from entities.reservation import Reservation

class ReserveBookUseCase:
    def __init__(self, book_repository, reservation_repository):
        self.book_repository = book_repository
        self.reservation_repository = reservation_repository

    def execute(self, reservation: Reservation):
        
        book = self.book_repository.search_by_title(reservation.book_name)
        
       
        if not book or len(book) == 0:
            raise ValueError("Book not found.")
        
        target_book = book[0]

        
        if not target_book.is_avalaible():
            raise ValueError("Book is not available.")

        
        target_book.reserve()

        
        self.book_repository.update(target_book)
        self.reservation_repository.add(reservation)

        return reservation