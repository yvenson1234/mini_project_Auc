from abc import ABC, abstractmethod


class BookRepository(ABC):

    @abstractmethod
    def add(self, book):
        pass

    @abstractmethod
    def update(self, book):
        pass

    @abstractmethod
    def get_by_id(self, book_id):
        pass

    @abstractmethod
    def list_all(self):
        pass

    @abstractmethod
    def search_by_title(self, title):
        pass