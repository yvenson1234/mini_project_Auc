from typing import List
from entities.book import Book
from interfaces.book_repository import BookRepository

class SearchBookUseCase:

    def __init__(self, book_repository: BookRepository):
        self.book_repository = book_repository

    def execute(self, title: str) -> List[Book]:
        clean_title = title.strip()
        if not clean_title:
            raise ValueError("Search title cannot be empty.")
            
        return self.book_repository.search_by_title(clean_title)